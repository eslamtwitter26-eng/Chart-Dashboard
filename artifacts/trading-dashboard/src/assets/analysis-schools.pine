//@version=6
indicator("Chart Dashboard - Analysis Schools", overlay = true, max_boxes_count = 100, max_lines_count = 200, max_labels_count = 200, max_bars_back = 500)

// Educational, rule-based candidates, not trade recommendations or a complete
// implementation of any school. Runs on the current TradingView chart's OHLC.
// Standard candles are required for price-based interpretation.
// Confirmed pivots arrive swingLen bars late and drawings are back-positioned.
// A same-direction pivot can replace the latest extreme after confirmation.
// No external prices, request.security calls, future prices, or order execution.
// Definitions and limitations: see the installation guide in the dashboard.

school = input.string("ICT", "Analysis school", options = ["ICT", "SMC", "Harmonic", "Elliott Waves"], group = "School")
swingLen = input.int(5, "Pivot confirmation bars (left and right)", minval = 2, maxval = 30, group = "School")
showStructure = input.bool(true, "BOS / CHoCH", group = "ICT / SMC")
showFvg = input.bool(true, "Fair Value Gaps", group = "ICT / SMC")
showOb = input.bool(true, "Order Block candidates", group = "ICT / SMC")
showSweeps = input.bool(true, "Liquidity sweeps", group = "ICT / SMC")
showRange = input.bool(true, "Premium / Discount (latest swing range)", group = "ICT / SMC")
minGapAtr = input.float(0.10, "Minimum FVG width / ATR", minval = 0.0, step = 0.05, group = "ICT / SMC")
displacementAtr = input.float(0.8, "Displacement body / ATR", minval = 0.0, step = 0.1, group = "ICT / SMC")
obLookback = input.int(15, "Order Block search bars before break", minval = 1, maxval = 50, group = "ICT / SMC")
maxZones = input.int(20, "Maximum active zones (FVG + OB)", minval = 1, maxval = 40, group = "ICT / SMC")
zoneLife = input.int(300, "Expire zones after bars", minval = 20, maxval = 2000, group = "ICT / SMC")
ratioTolerance = input.float(0.04, "Absolute Fibonacci ratio tolerance", minval = 0.01, maxval = 0.08, step = 0.01, group = "Harmonic")
showPanel = input.bool(true, "Show method / status panel", group = "Display")
bullColor = input.color(color.teal, "Bullish / Discount", group = "Display")
bearColor = input.color(color.red, "Bearish / Premium", group = "Display")

bool structureSchool = school == "ICT" or school == "SMC"
float atr = ta.atr(14)
float pivotHigh = ta.pivothigh(high, swingLen, swingLen)
float pivotLow = ta.pivotlow(low, swingLen, swingLen)

var array<float> prices = array.new_float()
var array<int> stamps = array.new_int()
var array<int> kinds = array.new_int()
var array<box> zones = array.new_box()
var array<int> zoneDirections = array.new_int()
var array<string> zoneKinds = array.new_string()
var array<int> zoneBorn = array.new_int()
var array<label> eventLabels = array.new_label()
var array<line> eventLines = array.new_line()
var array<label> patternLabels = array.new_label()
var array<line> patternLines = array.new_line()

f_pivot(float price, int stamp, int kind) =>
    bool changed = false
    int n = array.size(prices)
    if n == 0
        array.push(prices, price)
        array.push(stamps, stamp)
        array.push(kinds, kind)
        changed := true
    else if array.get(kinds, n - 1) == kind
        float previous = array.get(prices, n - 1)
        if (kind == 1 and price > previous) or (kind == -1 and price < previous)
            array.set(prices, n - 1, price)
            array.set(stamps, n - 1, stamp)
            changed := true
    else
        array.push(prices, price)
        array.push(stamps, stamp)
        array.push(kinds, kind)
        changed := true
    if array.size(prices) > 12
        array.shift(prices)
        array.shift(stamps)
        array.shift(kinds)
    changed

f_zone(int leftTime, float top, float bottom, int direction, string kind) =>
    color tint = direction == 1 ? bullColor : bearColor
    box b = box.new(left = leftTime, top = top, right = time, bottom = bottom, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(tint, 40), bgcolor = color.new(tint, 88), text = kind, text_color = tint, text_size = size.tiny)
    array.push(zones, b)
    array.push(zoneDirections, direction)
    array.push(zoneKinds, kind)
    array.push(zoneBorn, bar_index)
    if array.size(zones) > maxZones
        box.delete(array.shift(zones))
        array.shift(zoneDirections)
        array.shift(zoneKinds)
        array.shift(zoneBorn)

f_event(int origin, float level, string title, int direction) =>
    color tint = direction == 1 ? bullColor : bearColor
    array.push(eventLines, line.new(origin, level, time, level, xloc = xloc.bar_time, color = tint, style = line.style_dashed))
    array.push(eventLabels, label.new(time, level, title, xloc = xloc.bar_time, style = direction == 1 ? label.style_label_down : label.style_label_up, color = color.new(tint, 75), textcolor = tint, size = size.tiny))
    if array.size(eventLines) > 45
        line.delete(array.shift(eventLines))
        label.delete(array.shift(eventLabels))

f_clearPattern() =>
    while array.size(patternLines) > 0
        line.delete(array.pop(patternLines))
    while array.size(patternLabels) > 0
        label.delete(array.pop(patternLabels))

f_pattern(int start, int count, bool harmonic, int direction) =>
    color tint = direction == 1 ? bullColor : bearColor
    for i = 0 to count - 1
        int index = start + i
        string pointName = harmonic ? (i == 0 ? "X" : i == 1 ? "A" : i == 2 ? "B" : i == 3 ? "C" : "D") : str.tostring(i)
        array.push(patternLabels, label.new(array.get(stamps, index), array.get(prices, index), pointName, xloc = xloc.bar_time, style = array.get(kinds, index) == 1 ? label.style_label_down : label.style_label_up, color = color.new(tint, 60), textcolor = color.white, size = size.small))
        if i > 0
            array.push(patternLines, line.new(array.get(stamps, index - 1), array.get(prices, index - 1), array.get(stamps, index), array.get(prices, index), xloc = xloc.bar_time, color = tint, width = 2))

f_near(float value, float target) =>
    math.abs(value - target) <= ratioTolerance

f_between(float value, float lower, float upper) =>
    value >= lower - ratioTolerance and value <= upper + ratioTolerance

var float lastHigh = na
var float lastLow = na
var int highTime = na
var int lowTime = na
var bool highBroken = false
var bool lowBroken = false
var bool highSwept = false
var bool lowSwept = false
var int trend = 0
var box premium = na
var box discount = na
var line equilibrium = na
var string patternState = "Waiting for confirmed pivots"
var string patternDetails = "No forecast or trade signal"
var string latestEvent = "Waiting for a confirmed structure break"
var float patternInvalidation = na
var int patternDirection = 0
bool bullishBreak = false
bool bearishBreak = false
bool bullishGap = false
bool bearishGap = false
bool newCandidate = false

// All state changes wait for the current bar to close.
if barstate.isconfirmed
    // Remove completed or invalidated zones; retain no stale active rectangles.
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            box b = array.get(zones, i)
            bool bull = array.get(zoneDirections, i) == 1
            bool gap = array.get(zoneKinds, i) == "FVG"
            bool dead = gap ? (bull ? low <= box.get_bottom(b) : high >= box.get_top(b)) : (bull ? close < box.get_bottom(b) : close > box.get_top(b))
            if dead or bar_index - array.get(zoneBorn, i) > zoneLife
                box.delete(b)
                array.remove(zones, i)
                array.remove(zoneDirections, i)
                array.remove(zoneKinds, i)
                array.remove(zoneBorn, i)

    // Equal-bar high+low pivots have no knowable intrabar order; skip them.
    bool changed = false
    if not na(pivotHigh) and na(pivotLow)
        changed := f_pivot(pivotHigh, time[swingLen], 1)
        lastHigh := pivotHigh
        highTime := time[swingLen]
        highBroken := false
        highSwept := false
    else if not na(pivotLow) and na(pivotHigh)
        changed := f_pivot(pivotLow, time[swingLen], -1)
        lastLow := pivotLow
        lowTime := time[swingLen]
        lowBroken := false
        lowSwept := false

    if structureSchool
        bullishBreak := not na(lastHigh) and not highBroken and close > lastHigh
        bearishBreak := not na(lastLow) and not lowBroken and close < lastLow
        if showSweeps and not na(lastHigh) and not highBroken and not highSwept and high > lastHigh and close < lastHigh
            f_event(highTime, lastHigh, "Buy-side sweep", -1)
            highSwept := true
        if showSweeps and not na(lastLow) and not lowBroken and not lowSwept and low < lastLow and close > lastLow
            f_event(lowTime, lastLow, "Sell-side sweep", 1)
            lowSwept := true

        if bullishBreak or bearishBreak
            int direction = bullishBreak ? 1 : -1
            bool reversal = trend != 0 and trend != direction
            string title = trend == 0 ? "Initial break" : reversal ? "CHoCH" : "BOS"
            latestEvent := title + (direction == 1 ? " up" : " down")
            if showStructure
                f_event(direction == 1 ? highTime : lowTime, direction == 1 ? lastHigh : lastLow, title, direction)
            // OB definition: last opposing candle before a displaced close
            // through a confirmed swing. Entire candle range, not a guarantee.
            if showOb and math.abs(close - open) >= atr * displacementAtr
                for j = 1 to obLookback
                    bool opposing = direction == 1 ? close[j] < open[j] : close[j] > open[j]
                    if opposing
                        bool stillValid = direction == 1 ? close > high[j] : close < low[j]
                        if stillValid
                            f_zone(time[j], high[j], low[j], direction, "OB candidate")
                        break
            if bullishBreak
                highBroken := true
            if bearishBreak
                lowBroken := true
            trend := direction

        // ICT requires a directional displacement candle between gap edges.
        // SMC uses the raw three-candle imbalance plus minimum gap size.
        bool bullishDisplacement = close[1] > open[1] and math.abs(close[1] - open[1]) >= atr[1] * displacementAtr
        bool bearishDisplacement = close[1] < open[1] and math.abs(close[1] - open[1]) >= atr[1] * displacementAtr
        bullishGap := bar_index >= 2 and low > high[2] and low - high[2] >= atr * minGapAtr and (school == "SMC" or bullishDisplacement)
        bearishGap := bar_index >= 2 and high < low[2] and low[2] - high >= atr * minGapAtr and (school == "SMC" or bearishDisplacement)
        if showFvg and bullishGap
            f_zone(time[2], low, high[2], 1, "FVG")
        if showFvg and bearishGap
            f_zone(time[2], low[2], high, -1, "FVG")

        // A transparent dealing-range convention: latest confirmed swing
        // high and low. Not a claim that a discretionary range is unique.
        bool validRange = showRange and not na(lastHigh) and not na(lastLow) and lastHigh > lastLow
        if validRange
            float mid = (lastHigh + lastLow) / 2
            int leftTime = math.min(highTime, lowTime)
            if na(premium)
                premium := box.new(leftTime, lastHigh, time, mid, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(bearColor, 85), bgcolor = color.new(bearColor, 95), text = "Premium", text_color = color.new(bearColor, 30), text_size = size.tiny)
                discount := box.new(leftTime, mid, time, lastLow, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(bullColor, 85), bgcolor = color.new(bullColor, 95), text = "Discount", text_color = color.new(bullColor, 30), text_size = size.tiny)
                equilibrium := line.new(leftTime, mid, time, mid, xloc = xloc.bar_time, extend = extend.right, color = color.gray, style = line.style_dotted)
            box.set_lefttop(premium, leftTime, lastHigh)
            box.set_rightbottom(premium, time, mid)
            box.set_lefttop(discount, leftTime, mid)
            box.set_rightbottom(discount, time, lastLow)
            line.set_xy1(equilibrium, leftTime, mid)
            line.set_xy2(equilibrium, time, mid)
        else if not na(premium)
            box.delete(premium)
            box.delete(discount)
            line.delete(equilibrium)
            premium := na
            discount := na
            equilibrium := na

    if not structureSchool and changed
        f_clearPattern()
        patternState := "No supported candidate at latest pivots"
        patternDetails := "Rules not met; no pattern forced"
        patternInvalidation := na
        patternDirection := 0
        int n = array.size(prices)
        if school == "Harmonic" and n >= 5
            int start = n - 5
            float x = array.get(prices, start)
            float a = array.get(prices, start + 1)
            float b = array.get(prices, start + 2)
            float c = array.get(prices, start + 3)
            float d = array.get(prices, start + 4)
            int direction = array.get(kinds, start) == -1 ? 1 : -1
            float xa = math.abs(a - x)
            float ab = math.abs(b - a)
            float bc = math.abs(c - b)
            float cd = math.abs(d - c)
            bool geometry = direction == 1 ? (a > x and b > x and b < a and c > b and c < a and d > x and d < b) : (a < x and b < x and b > a and c < b and c > a and d < x and d > b)
            if geometry and xa > syminfo.mintick and ab > syminfo.mintick and bc > syminfo.mintick
                float rAB = ab / xa
                float rBC = bc / ab
                float rCD = cd / bc
                float rAD = math.abs(d - a) / xa
                float rABCD = cd / ab
                bool gartley = f_near(rAB, 0.618) and f_between(rBC, 0.382, 0.886) and f_between(rCD, 1.27, 1.618) and f_near(rAD, 0.786) and f_near(rABCD, 1.0)
                bool bat = f_between(rAB, 0.382, 0.50) and f_between(rBC, 0.382, 0.886) and f_between(rCD, 1.618, 2.618) and f_near(rAD, 0.886) and f_near(rABCD, 1.27)
                if gartley or bat
                    f_pattern(start, 5, true, direction)
                    patternState := (gartley ? "Gartley" : "Bat") + (direction == 1 ? " bullish candidate" : " bearish candidate")
                    patternDetails := "AB/XA " + str.tostring(rAB, "#.###") + " | AD/XA " + str.tostring(rAD, "#.###")
                    patternInvalidation := x
                    patternDirection := direction
                    newCandidate := true
                    array.push(patternLabels, label.new(time, close, patternState + "\nConfirmed now; D is historical\nInvalid beyond X: " + str.tostring(x, format.mintick), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(direction == 1 ? bullColor : bearColor, 25), textcolor = color.white, size = size.small))
        else if school == "Elliott Waves" and n >= 6
            int start = n - 6
            int direction = array.get(kinds, start) == -1 ? 1 : -1
            float p0 = array.get(prices, start) * direction
            float p1 = array.get(prices, start + 1) * direction
            float p2 = array.get(prices, start + 2) * direction
            float p3 = array.get(prices, start + 3) * direction
            float p4 = array.get(prices, start + 4) * direction
            float p5 = array.get(prices, start + 5) * direction
            float w1 = p1 - p0
            float w3 = p3 - p2
            float w5 = p5 - p4
            // Conservative, non-truncated impulse candidate:
            // wave 2 holds origin; wave 4 cannot overlap wave 1;
            // wave 3 exceeds wave 1's end and is not the shortest motive leg.
            bool impulse = p1 > p0 and p2 > p0 and p2 < p1 and p3 > p1 and p4 > p1 and p4 < p3 and p5 > p3 and w3 >= math.min(w1, w5)
            if impulse
                f_pattern(start, 6, false, direction)
                patternState := direction == 1 ? "Upward 1-5 impulse candidate" : "Downward 1-5 impulse candidate"
                patternDetails := "Subwaves / ABC / diagonals NOT checked"
                newCandidate := true
                array.push(patternLabels, label.new(time, close, patternState + "\nConfirmed now; no wave-6 prediction", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(direction == 1 ? bullColor : bearColor, 25), textcolor = color.white, size = size.small))

    if school == "Harmonic" and not na(patternInvalidation)
        bool invalid = patternDirection == 1 ? low <= patternInvalidation : high >= patternInvalidation
        if invalid
            f_clearPattern()
            patternState := "Candidate invalidated beyond X"
            patternDetails := "Wait for a new confirmed swing pattern"
            patternInvalidation := na
            patternDirection := 0
            newCandidate := false

var table panel = table.new(position.top_right, 1, 6, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast and showPanel
    string stateText = structureSchool ? latestEvent : patternState
    string details = structureSchool ? "Active zones: " + str.tostring(array.size(zones)) + " | Range: latest confirmed high/low" : patternDetails
    table.cell(panel, 0, 0, "Chart Dashboard | " + school, text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 1, stateText, text_color = color.silver, text_size = size.small)
    table.cell(panel, 0, 2, details, text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 0, 3, "Pivots delayed " + str.tostring(swingLen) + " bars; drawn back at swing", text_color = color.orange, text_size = size.tiny)
    table.cell(panel, 0, 4, "Use standard candles. Rule-based candidates only.", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 0, 5, "Not a forecast, backtest, or trading recommendation", text_color = color.silver, text_size = size.tiny)

alertcondition(bullishBreak, "Bullish structure break", "Confirmed bullish swing break on {{ticker}} {{interval}}.")
alertcondition(bearishBreak, "Bearish structure break", "Confirmed bearish swing break on {{ticker}} {{interval}}.")
alertcondition(bullishGap and showFvg, "Bullish FVG", "Bullish FVG identified on {{ticker}} {{interval}}.")
alertcondition(bearishGap and showFvg, "Bearish FVG", "Bearish FVG identified on {{ticker}} {{interval}}.")
alertcondition(newCandidate, "New pattern candidate", "Confirmed rule-based pattern candidate on {{ticker}} {{interval}}. Inspect chart; this is not a trade instruction.")
